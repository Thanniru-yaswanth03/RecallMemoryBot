# ============================================================
# RecallMemoryBot Environment Configuration Template
# Copy this file to .env and provide your local credentials.
# NEVER commit the actual .env file or real credentials to Git.
# ============================================================

# Application Server
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_WEBHOOK_SECRET=YOUR_TELEGRAM_WEBHOOK_SECRET_HERE
TELEGRAM_BOT_USERNAME=recall_memory_bot
TELEGRAM_MODE=polling

# OpenRouter AI Credentials
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE
RECALL_AI_CHAT_MODEL=inclusionai/ling-3.0-flash-sante:free
RECALL_AI_EMBEDDING_MODEL=openai/text-embedding-3-small
RECALL_AI_EMBEDDING_DIMENSION=1536
RECALL_AI_MAX_OUTPUT_TOKENS=800

# PostgreSQL & pgvector Database (Phase 1+)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/recall_db
SPRING_DATASOURCE_USERNAME=recall_user
SPRING_DATASOURCE_PASSWORD=YOUR_DATABASE_PASSWORD_HERE

# Admin Panel Configuration
RECALL_ADMIN_ENABLED=true
RECALL_ADMIN_USERNAME=admin
RECALL_ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD_HERE
RECALL_ADMIN_SESSION_TTL_HOURS=12
RECALL_ADMIN_MAX_LOGIN_ATTEMPTS=5
RECALL_ADMIN_LOCKOUT_MINUTES=15

